
:root {
    --cor-primaria: #087cff;
    --cor-secundaria: #20a4ff;
    --fundo: #080b10;
    --superficie: #111720;
    --superficie-2: #192330;
    --texto: #f1f5f9;
    --texto-suave: #94a3b8;
    --borda: #273447;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--fundo);
    color: var(--texto);
    overflow-x: hidden;
}

/* BARRA SUPERIOR */
.top-bar {
    background: #05070b;
    color: var(--cor-secundaria);
    text-align: center;
    padding: 10px 15px;
    font-size: .85rem;
    font-weight: 700;
    border-bottom: 1px solid var(--borda);
}

/* CABEÇALHO */
header {
    background: #0b1018;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 5%;
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid var(--borda);
    box-shadow: 0 5px 20px rgba(0,0,0,.35);
    flex-wrap: wrap;
    gap: 15px;
}

.logo-grande {
    font-size: 1.8rem;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 900;
    letter-spacing: -.5px;
}

.logo-grande i,
.footer-logo i {
    color: var(--cor-secundaria);
}

/* SELETOR DE CORES */
.theme-switcher {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--superficie-2);
    padding: 6px 12px;
    border-radius: 20px;
    border: 1px solid var(--borda);
}

.theme-label {
    font-size: .8rem;
    font-weight: 600;
    color: var(--texto-suave);
}

.color-btn {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid #fff;
    cursor: pointer;
    box-shadow: 0 2px 4px rgba(0,0,0,.3);
    transition: transform .2s;
}

.color-btn:hover {
    transform: scale(1.2);
}

/* AÇÕES DO CABEÇALHO */
.header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

.cart-btn {
    background: var(--superficie-2);
    border: 1px solid var(--borda);
    color: #fff;
    width: 44px;
    height: 44px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    cursor: pointer;
    transition: .2s;
}

.cart-btn:hover {
    background: var(--cor-primaria);
    border-color: var(--cor-primaria);
}

.cart-count {
    position: absolute;
    top: -6px;
    right: -6px;
    background: #ef4444;
    color: white;
    font-size: .75rem;
    font-weight: 700;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* MENU */
.menu-container {
    position: relative;
}

.menu-toggle-btn {
    background: var(--cor-primaria);
    color: white;
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 9px;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: .2s;
}

.menu-toggle-btn:hover {
    background: var(--cor-secundaria);
}

.dropdown-content {
    display: none;
    position: absolute;
    right: 0;
    top: 120%;
    background: var(--superficie);
    min-width: 200px;
    box-shadow: 0 10px 25px rgba(0,0,0,.5);
    border-radius: 10px;
    border: 1px solid var(--borda);
    overflow: hidden;
    z-index: 1001;
}

.dropdown-content.show {
    display: block;
}

.dropdown-content a {
    color: var(--texto);
    padding: 13px 18px;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: .95rem;
    border-bottom: 1px solid var(--borda);
}

.dropdown-content a:hover {
    background: var(--superficie-2);
    color: var(--cor-secundaria);
}

.dropdown-content a i {
    width: 20px;
    color: var(--cor-secundaria);
}

/* CARRINHO LATERAL */
.cart-drawer {
    position: fixed;
    top: 0;
    right: -420px;
    width: 100%;
    max-width: 380px;
    height: 100%;
    height: 100dvh;
    background: var(--superficie);
    box-shadow: -5px 0 25px rgba(0,0,0,.5);
    z-index: 2000;
    display: flex;
    flex-direction: column;
    transition: right .3s ease;
}

.cart-drawer.open {
    right: 0;
}

.cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.7);
    z-index: 1999;
    display: none;
}

.cart-overlay.open {
    display: block;
}

.cart-header {
    padding: 20px;
    background: #080d15;
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--borda);
}

.cart-header h3 {
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 8px;
}

.close-cart {
    background: none;
    border: none;
    color: white;
    font-size: 1.8rem;
    cursor: pointer;
}

.cart-items {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
}

.cart-empty {
    text-align: center;
    color: var(--texto-suave);
    margin-top: 40px;
}

.cart-item {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--borda);
    align-items: center;
}

.cart-item img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 8px;
    background: var(--superficie-2);
}

.cart-item-details {
    flex: 1;
    min-width: 0;
}

.cart-item-details h4 {
    font-size: .9rem;
    color: #fff;
    margin-bottom: 3px;
}

.cart-item-size {
    font-size: .75rem;
    color: var(--texto-suave);
    margin-bottom: 4px;
}

.cart-item-price {
    font-size: .9rem;
    font-weight: 700;
    color: #22c55e;
    margin: 6px 0;
}

.cart-item-qty {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--texto-suave);
}

.cart-item-qty button {
    background: var(--superficie-2);
    border: 1px solid var(--borda);
    color: white;
    width: 28px;
    height: 28px;
    border-radius: 5px;
    font-weight: bold;
    cursor: pointer;
}

.cart-item-qty span {
    font-size: .85rem;
    font-weight: 600;
}

.cart-footer {
    padding: 20px;
    background: #0b1018;
    border-top: 1px solid var(--borda);
}

.cart-total {
    display: flex;
    justify-content: space-between;
    font-size: 1.1rem;
    margin-bottom: 15px;
    color: white;
}

.btn-checkout {
    width: 100%;
    background: #16a34a;
    color: white;
    border: none;
    padding: 14px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: .2s;
}

.btn-checkout:hover {
    background: #15803d;
}

/* BANNER PRINCIPAL */
.hero {
    background:
        linear-gradient(rgba(4,8,15,.82), rgba(4,8,15,.92)),
        url('https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=1400&q=80');
    background-size: cover;
    background-position: center;
    min-height: 65vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    padding: 50px 20px;
}

.badge-hero {
    background: rgba(8,124,255,.15);
    color: var(--cor-secundaria);
    border: 1px solid rgba(32,164,255,.4);
    padding: 7px 15px;
    border-radius: 20px;
    font-size: .85rem;
    font-weight: 700;
    display: inline-block;
    margin-bottom: 20px;
    text-transform: uppercase;
}

.hero-content h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 15px;
    font-weight: 900;
    text-transform: uppercase;
}

.hero-content p {
    font-size: 1.1rem;
    margin: 0 auto 30px;
    max-width: 600px;
    color: #cbd5e1;
    line-height: 1.6;
}

.btn-cta {
    display: inline-block;
    background: var(--cor-primaria);
    color: white;
    padding: 14px 30px;
    border-radius: 8px;
    font-weight: 800;
    text-decoration: none;
    transition: .2s;
    box-shadow: 0 4px 18px rgba(8,124,255,.3);
}

.btn-cta:hover {
    background: var(--cor-secundaria);
    transform: translateY(-3px);
}

/* BENEFÍCIOS */
.beneficios {
    max-width: 1200px;
    margin: -30px auto 40px;
    padding: 0 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 18px;
    position: relative;
    z-index: 10;
}

.beneficio-item {
    background: var(--superficie);
    padding: 22px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 18px;
    border: 1px solid var(--borda);
    box-shadow: 0 8px 25px rgba(0,0,0,.25);
}

.beneficio-item i {
    font-size: 1.8rem;
    color: var(--cor-secundaria);
}

.beneficio-item h4 {
    font-size: .95rem;
    color: white;
    margin-bottom: 4px;
}

.beneficio-item p {
    font-size: .8rem;
    color: var(--texto-suave);
}

/* VITRINE */
.produtos-container {
    max-width: 1200px;
    margin: 60px auto;
    padding: 0 20px;
}

.section-title {
    text-align: center;
    margin-bottom: 40px;
}

.section-title h2 {
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    color: white;
    font-weight: 900;
    margin-bottom: 8px;
    text-transform: uppercase;
}

.section-title p {
    color: var(--texto-suave);
}

.grid-produtos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 25px;
}

/* CARDS DOS PRODUTOS */
.card-produto {
    background: var(--superficie);
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--borda);
    position: relative;
    transition: transform .3s, border-color .3s;
}

.card-produto:hover {
    transform: translateY(-6px);
    border-color: var(--cor-primaria);
    box-shadow: 0 12px 30px rgba(0,0,0,.4);
}

.produto-img-wrapper {
    overflow: hidden;
    height: 260px;
    background: var(--superficie-2);
}

.card-produto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s;
}

.card-produto:hover img {
    transform: scale(1.05);
}

.tag-time,
.tag-gym {
    position: absolute;
    top: 15px;
    left: 15px;
    color: white;
    padding: 5px 12px;
    font-size: .75rem;
    font-weight: 700;
    border-radius: 6px;
    text-transform: uppercase;
    z-index: 2;
}

.tag-time {
    background: #d97706;
}

.tag-gym {
    background: var(--cor-primaria);
}

.card-info {
    padding: 20px;
}

.card-info h3 {
    font-size: 1.05rem;
    margin-bottom: 5px;
    color: white;
}

.categoria {
    font-size: .8rem;
    color: var(--texto-suave);
    margin-bottom: 14px;
}

/* TAMANHOS */
.tamanhos-container {
    margin-bottom: 16px;
}

.label-tamanho {
    font-size: .8rem;
    color: var(--texto-suave);
    display: block;
    margin-bottom: 7px;
    font-weight: 600;
}

.tamanhos-botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.btn-tamanho {
    background: var(--superficie-2);
    border: 1px solid var(--borda);
    color: white;
    padding: 7px 13px;
    border-radius: 6px;
    font-size: .85rem;
    font-weight: 600;
    cursor: pointer;
    transition: .2s;
}

.btn-tamanho:hover {
    border-color: var(--cor-secundaria);
    color: var(--cor-secundaria);
}

.btn-tamanho.ativo {
    background: var(--cor-primaria);
    color: white;
    border-color: var(--cor-primaria);
}

/* PREÇOS E COMPRA */
.preco-container {
    margin-bottom: 16px;
}

.preco {
    font-size: 1.35rem;
    font-weight: 900;
    color: #22c55e;
}

.btn-comprar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background: var(--cor-primaria);
    color: white;
    border: none;
    padding: 13px;
    border-radius: 8px;
    font-size: .95rem;
    font-weight: 800;
    cursor: pointer;
    transition: .2s;
}

.btn-comprar:hover {
    background: var(--cor-secundaria);
    transform: translateY(-2px);
}

/* RODAPÉ */
footer {
    background: #05080e;
    color: var(--texto-suave);
    text-align: center;
    padding: 40px 20px;
    margin-top: 60px;
    border-top: 1px solid var(--borda);
}

.footer-logo {
    font-size: 1.3rem;
    color: white;
    margin-bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 900;
}

.copyright {
    color: #64748b;
    font-size: .8rem;
    margin-top: 15px;
}

/* TABLETS */
@media (max-width: 768px) {
    header {
        padding: 14px 4%;
    }

    .hero {
        min-height: 55vh;
    }

    .grid-produtos {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .produto-img-wrapper {
        height: 210px;
    }

    .card-info {
        padding: 14px;
    }
}

/* CELULARES */
@media (max-width: 600px) {
    header {
        padding: 12px 4%;
        gap: 10px;
    }

    .logo-grande {
        font-size: 1.35rem;
    }

    .header-actions {
        gap: 8px;
    }

    .theme-switcher {
        gap: 5px;
        padding: 5px 8px;
    }

    .theme-label {
        font-size: .7rem;
    }

    .hero {
        min-height: 48vh;
        padding: 40px 15px;
    }

    .hero-content p {
        font-size: .95rem;
    }

    .beneficios {
        grid-template-columns: 1fr;
        margin-top: -15px;
    }

    .beneficio-item {
        padding: 17px;
    }

    .produtos-container {
        margin: 40px auto;
        padding: 0 12px;
    }

    .section-title {
        margin-bottom: 25px;
    }

    .grid-produtos {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .produto-img-wrapper {
        height: 170px;
    }

    .card-info {
        padding: 12px;
    }

    .card-info h3 {
        font-size: .9rem;
    }

    .categoria {
        font-size: .72rem;
    }

    .btn-tamanho {
        padding: 6px 9px;
        font-size: .75rem;
    }

    .preco {
        font-size: 1.1rem;
    }

    .btn-comprar {
        padding: 11px 6px;
        font-size: .8rem;
    }

    .cart-drawer {
        max-width: 100%;
    }
}

/* CELULARES PEQUENOS */
@media (max-width: 360px) {
    .logo-grande {
        font-size: 1.15rem;
    }

    .grid-produtos {
        grid-template-columns: 1fr;
    }

    .produto-img-wrapper {
        height: 230px;
    }

    .theme-label {
        display: none;
    }
}

/* ACESSIBILIDADE */
button,
a {
    -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
a:focus-visible {
    outline: 2px solid var(--cor-secundaria);
    outline-offset: 3px;
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
    }
}
