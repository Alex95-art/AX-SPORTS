* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #f4f6f9;
    color: #333;
}

/* Cabeçalho */
header {
    background-color: #111;
    color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 5%;
    position: sticky;
    top: 0;
    z-index: 100;
}

header .logo {
    font-size: 1.5rem;
    font-weight: bold;
    color: #00ffcc;
    display: flex;
    align-items: center;
    gap: 10px;
}

header nav {
    display: flex;
    gap: 20px;
    align-items: center;
}

header nav a {
    color: #fff;
    text-decoration: none;
    transition: color 0.3s;
}

header nav a:hover {
    color: #00ffcc;
}

.btn-whats-nav {
    background-color: #25d366;
    padding: 8px 15px;
    border-radius: 20px;
    font-weight: bold;
}

.btn-whats-nav:hover {
    color: #fff !important;
    background-color: #20ba59;
}

/* Hero Banner */
.hero {
    background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=1200&q=80');
    background-size: cover;
    background-position: center;
    height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    padding: 0 20px;
}

.hero-content h1 {
    font-size: 2.8rem;
    margin-bottom: 15px;
    color: #fff;
}

.hero-content p {
    font-size: 1.2rem;
    margin-bottom: 25px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    color: #ddd;
}

.btn-cta {
    background-color: #00ffcc;
    color: #111;
    padding: 12px 30px;
    border-radius: 30px;
    font-weight: bold;
    text-decoration: none;
    display: inline-block;
    transition: background 0.3s;
}

.btn-cta:hover {
    background-color: #00cca3;
}

/* Vitrine de Produtos */
.produtos-container {
    max-width: 1200px;
    margin: 50px auto;
    padding: 0 20px;
}

.produtos-container h2 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 40px;
    color: #222;
}

.grid-produtos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 30px;
}

.card-produto {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    position: relative;
    transition: transform 0.3s;
}

.card-produto:hover {
    transform: translateY(-5px);
}

.card-produto img {
    width: 100%;
    height: 280px;
    object-fit: cover;
}

.tag-time {
    position: absolute;
    top: 15px;
    left: 15px;
    background-color: #ffcc00;
    color: #111;
    padding: 5px 10px;
    font-size: 0.8rem;
    font-weight: bold;
    border-radius: 4px;
}

.tag-gym {
    position: absolute;
    top: 15px;
    left: 15px;
    background-color: #007bff;
    color: #fff;
    padding: 5px 10px;
    font-size: 0.8rem;
    font-weight: bold;
    border-radius: 4px;
}

.card-info {
    padding: 20px;
}

.card-info h3 {
    font-size: 1.1rem;
    margin-bottom: 8px;
    color: #222;
}

.categoria {
    font-size: 0.85rem;
    color: #777;
    margin-bottom: 15px;
}

.preco-container {
    margin-bottom: 15px;
}

.preco {
    font-size: 1.3rem;
    font-weight: bold;
    color: #27ae60;
}

.btn-comprar {
    display: block;
    width: 100%;
    background-color: #25d366;
    color: white;
    text-align: center;
    padding: 10px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    transition: background 0.3s;
}

.btn-comprar:hover {
    background-color: #20ba59;
}

/* Rodapé */
footer {
    background-color: #111;
    color: #aaa;
    text-align: center;
    padding: 25px 0;
    margin-top: 50px;
    font-size: 0.9rem;
}
